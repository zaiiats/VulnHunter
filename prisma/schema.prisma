generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  RESEARCHER
  COMPANY
  ADMIN
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  OPEN
  TRIAGED
  RESOLVED
  INVALID
  SPAM
}

// ==========================================
// AUTH.JS V5 MODELS
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(RESEARCHER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  comment       Comment[]
  reports       Report[]        @relation("SubmittedReports")
  companyProfile CompanyProfile?

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// BUSINESS LOGIC MODELS
// ==========================================

model CompanyProfile {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  website     String
  scope       String   @db.Text
  bountyPool  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports     Report[]

  @@index([slug])
}

model Report {
  id                String       @id @default(cuid())
  title             String
  target            String       
  vulnerabilityType String
  severity          Severity
  status            ReportStatus @default(OPEN)

  stepsToReproduce  String       @db.Text
  cvssScore         Float?
  bountyPaid        Int?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  researcherId      String
  researcher        User         @relation("SubmittedReports", fields: [researcherId], references: [id], onDelete: Cascade)

  companyId         String
  company           CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  comments          Comment[]

  @@index([researcherId])
  @@index([companyId])
  @@index([status])
  @@index([severity])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([authorId])
}